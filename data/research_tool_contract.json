{
  "schema": "aether.research_tool_contract/v0",
  "tool": "research.query",
  "phase": "F5_draft",
  "ref": "docs/F5_RESEARCH_TOOL_CONTRACT.md",
  "depends_on": ["F2", "F2.5"],
  "input": {
    "question": "string",
    "abstain_reason": {"enum": ["unknown"], "only": "unknown"},
    "state_digest_max_tokens": 320,
    "allow_network_default": false,
    "ampliar": {
      "hitl_only": true,
      "ack_required": "SIM"
    }
  },
  "output": {
    "verdict": ["settled", "weak", "open"],
    "authority_max": 120,
    "never_255_without_hitl": true,
    "fields": [
      "sources",
      "n_independent",
      "numeric",
      "semantic",
      "quarantine",
      "ampliacao_mark"
    ]
  },
  "tier_table": "data/source_tier.json",
  "eval_tiers": ["T0", "T1", "T2", "T3"]
}
