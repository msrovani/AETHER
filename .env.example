# Copie para `.env` (gitignored). Não coloque segredos aqui sem necessidade.
# aether-sgdb carrega este arquivo automaticamente ao subir.

# Transporte: stdio (launcher neural-sgdb) OU HTTP MCP.
# DB dedicado do motor AETHER — NÃO use o memory.db do Cursor MCP em paralelo.
AETHER_SGDB_STDIO=powershell -NoProfile -ExecutionPolicy Bypass -File ../neural-sgdb/scripts/mcp-server.ps1
NEURAL_SGDB_DB=.nsgdb/memory.db
NEURAL_SGDB_DEFAULT_SCOPE=aether/project

# Outbox para não perder puts se o MCP cair
AETHER_SGDB_OUTBOX=target/aether_sgdb.jsonl

# Escopo canônico (defaults da CLI se omitidos)
# AETHER_SGDB_ORGANISM=1
# AETHER_SGDB_RUN=0
# AETHER_SGDB_APP=1
# AETHER_SGDB_SCOPE_APP=AETHER

# Alternativa HTTP (se houver bridge em :8090):
# AETHER_SGDB_URL=http://127.0.0.1:8090/mcp
